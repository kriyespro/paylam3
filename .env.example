# --- Local (non-Docker) dev ---
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Production / Docker ---
# DJANGO_SETTINGS_MODULE=config.settings.prod   (set this in your deploy env, not here)

# Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(50))"
# SECRET_KEY=

# Real domain(s), comma-separated, no scheme:
# ALLOWED_HOSTS=thebasics.example.com

# Real domain(s) with scheme — required for CSRF to work behind HTTPS:
# CSRF_TRUSTED_ORIGINS=https://thebasics.example.com

# Postgres — docker-compose reads these to configure the db service AND
# builds DATABASE_URL for the web service automatically (see
# docker-compose.yml); only needed here, not also duplicated as
# DATABASE_URL.
POSTGRES_DB=thebasics
POSTGRES_USER=thebasics
POSTGRES_PASSWORD=change-me-too

# Outside Docker (e.g. running prod settings directly against a managed
# Postgres), set the full URL instead:
# DATABASE_URL=postgres://user:password@host:5432/thebasics

# How many days of daily pg_dump backups the `backup` compose service keeps
# (docker/backup.sh) — stored in the postgres_backups named volume. Redis
# has no backup — it's a pure cache (see docker-compose.yml's comment on
# the backup service), rebuildable, not a source of truth.
BACKUP_RETENTION_DAYS=14

# Redis — docker-compose sets this automatically to the redis service;
# only needed here if running prod settings outside Docker.
# REDIS_URL=redis://localhost:6379/1

# Real SMTP — without this, password-reset emails fail to send in prod.
# EMAIL_HOST=smtp.your-provider.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@thebasics.example.com

# "Sign in with Google" — OAuth 2.0 Client ID from Google Cloud Console
# (Credentials > OAuth client ID > Web application). Add both the site's
# origin under "Authorized JavaScript origins" and /accounts/google/ under
# "Authorized redirect URIs". Login/signup pages hide the Google button
# when this is unset.
# GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com

# Razorpay — Key ID/Secret from the Razorpay dashboard (Settings > API
# Keys). Use the test keys while developing; the checkout flow and
# webhook signature check both need these set.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# Signing secret set on the webhook in the Razorpay dashboard (Settings >
# Webhooks), used to activate subscriptions if the browser never returns
# from Checkout to call /billing/verify/.
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# Only set these to False for a first plain-HTTP smoke test of the Docker
# stack before real TLS is in front of it (docker/nginx.conf ships HTTP
# only — no certs to bundle without a real domain). Leave unset (defaults
# to True/secure) once there's a real TLS-terminating proxy or LB.
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
